+
+
+def test_fee_accrues_until_today_if_still_out():
+    lib = make_lib()
+    lib.checkout("M1", "111", date(2026, 10, 1))  # due Oct 15
+    assert lib.fees_owed("M1", date(2026, 10, 19)) == 100
+
+
+def test_premium_first_three_late_days_free():
+    lib = make_lib()
+    lib.checkout("M2", "111", date(2026, 10, 1))  # due Oct 15
+    lib.return_book("111", date(2026, 10, 19))    # 4 days late, 1 charged
+    assert lib.fees_owed("M2", date(2026, 10, 25)) == 25
+
+
+def test_fee_capped_per_loan():
+    lib = make_lib()
+    lib.checkout("M1", "111", date(2026, 8, 1))  # due Aug 15
+    lib.return_book("111", date(2026, 10, 25))   # well past 40 late days
+    assert lib.fees_owed("M1", date(2026, 10, 25)) == 1000
+
+
+def test_report_includes_fees():
+    lib = make_lib()
+    lib.checkout("M1", "111", date(2026, 10, 1))
+    lib.return_book("111", date(2026, 10, 19))
+    out = report(lib, date(2026, 10, 25))
+    assert "M1 Ada: 1 loans, 0 overdue, fees $1.00" in out
