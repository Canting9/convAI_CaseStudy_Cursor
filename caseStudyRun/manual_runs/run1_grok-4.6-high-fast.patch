+++ b/shelf/library.py
@@ -4,6 +4,9 @@ from typing import Dict, List, Optional
 from .models import Book, Loan, Member
 
 LOAN_DAYS = 14
+FEE_CENTS_PER_DAY = 25
+FEE_CAP_CENTS = 1000
+PREMIUM_FREE_DAYS = 3
 
 
 class LibraryError(Exception):
@@ -54,3 +57,17 @@ class Library:
             loan for loan in self.loans
             if loan.returned is None and today > loan.due
         ]
+
+    def _late_days(self, loan: Loan, today: date) -> int:
+        end = loan.returned if loan.returned is not None else today
+        return max((end - loan.due).days, 0)
+
+    def _fee_for_loan(self, loan: Loan, today: date) -> int:
+        days = self._late_days(loan, today)
+        member = self.members.get(loan.member_id)
+        if member is not None and member.tier == "premium":
+            days = max(0, days - PREMIUM_FREE_DAYS)
+        return min(days * FEE_CENTS_PER_DAY, FEE_CAP_CENTS)
+
+    def fees_owed(self, member_id: str, today: date) -> int:
+        return sum(self._fee_for_loan(loan, today) for loan in self.loans_for(member_id))
